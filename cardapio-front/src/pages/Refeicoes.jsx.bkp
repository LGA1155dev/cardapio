/* ═══════════════════════════════
   FORK SVG
═══════════════════════════════ */
function ForkSVG() {
  return (
    <svg viewBox="0 0 100 300" xmlns="http://www.w3.org/2000/svg" className="fork-svg">
      <defs>
        <linearGradient id="fmain" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stopColor="#1e3a8a" />
          <stop offset="30%"  stopColor="#60a5fa" />
          <stop offset="52%"  stopColor="#ffffff" />
          <stop offset="75%"  stopColor="#93c5fd" />
          <stop offset="100%" stopColor="#1d4ed8" />
        </linearGradient>
        <linearGradient id="fhandle" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stopColor="#0f2057" />
          <stop offset="28%"  stopColor="#2563eb" />
          <stop offset="52%"  stopColor="#bfdbfe" />
          <stop offset="78%"  stopColor="#1d4ed8" />
          <stop offset="100%" stopColor="#0a1535" />
        </linearGradient>
        <filter id="fglow">
          <feGaussianBlur stdDeviation="2" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <rect x="12" y="8"  width="8" height="85" rx="4" fill="url(#fmain)" filter="url(#fglow)" />
      <rect x="28" y="8"  width="8" height="92" rx="4" fill="url(#fmain)" opacity=".9" />
      <rect x="44" y="8"  width="8" height="92" rx="4" fill="url(#fmain)" opacity=".9" />
      <rect x="60" y="8"  width="8" height="85" rx="4" fill="url(#fmain)" filter="url(#fglow)" />
      <ellipse cx="16"  cy="8"  rx="4" ry="2.5" fill="#93c5fd" opacity=".9" />
      <ellipse cx="32"  cy="8"  rx="4" ry="2.5" fill="#bfdbfe" opacity=".9" />
      <ellipse cx="48"  cy="8"  rx="4" ry="2.5" fill="#bfdbfe" opacity=".9" />
      <ellipse cx="64"  cy="8"  rx="4" ry="2.5" fill="#93c5fd" opacity=".9" />
      <path d="M12 93 Q12 112 36 116 L64 116 Q88 112 88 93 L88 86 L12 86Z" fill="url(#fmain)" />
      <rect x="35" y="114" width="30" height="52" fill="url(#fmain)" />
      <path d="M26 164 Q24 170 24 180 L24 252 Q24 272 50 276 Q76 272 76 252 L76 180 Q76 170 74 164Z" fill="url(#fhandle)" />
      <rect x="24" y="185" width="52" height="7" fill="url(#fmain)" opacity=".7" />
      <rect x="24" y="217" width="52" height="7" fill="url(#fmain)" opacity=".7" />
      <rect x="24" y="248" width="52" height="7" fill="url(#fmain)" opacity=".7" />
      <path d="M32 168 Q31 174 31 180 L31 249 Q32 265 50 270" fill="none" stroke="white" strokeWidth="3" opacity=".18" strokeLinecap="round" />
      <path d="M34 168 Q33 174 33 180 L33 248 Q34 262 50 267" fill="none" stroke="white" strokeWidth="1.2" opacity=".3" strokeLinecap="round" />
      <ellipse cx="50" cy="275" rx="26" ry="7" fill="url(#fmain)" />
      <ellipse cx="50" cy="275" rx="14" ry="3.5" fill="white" opacity=".26" />
    </svg>
  );
}

/* ═══════════════════════════════
   LOADING SCREEN
═══════════════════════════════ */
function LoadingScreen({ onDone }) {
  const canvasRef = useRef(null);
  const animRef   = useRef(null);
  const [pct, setPct]     = useState(0);
  const [exiting, setExiting] = useState(false);

  /* canvas: dot grid + central ring */
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let W = (canvas.width  = window.innerWidth);
    let H = (canvas.height = window.innerHeight);

    const COLS = 26, ROWS = 16;
    const dots = [];
    for (let r = 0; r < ROWS; r++)
      for (let c = 0; c < COLS; c++)
        dots.push({
          x: (c / (COLS - 1)) * W,
          y: (r / (ROWS - 1)) * H,
          phase: Math.random() * Math.PI * 2,
        });

    let t = 0;
    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = "#04080f";
      ctx.fillRect(0, 0, W, H);

      dots.forEach((d) => {
        const wave   = Math.sin(t * 0.04 + d.phase) * 0.5 + 0.5;
        const dist   = Math.hypot(d.x - W / 2, d.y - H / 2) / Math.hypot(W / 2, H / 2);
        const ripple = Math.sin(t * 0.06 - dist * 8) * 0.5 + 0.5;
        const alpha  = wave * 0.28 + ripple * 0.18;
        const size   = 1.4 + ripple * 2;
        ctx.beginPath();
        ctx.arc(d.x, d.y, size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(96,165,250,${alpha})`;
        ctx.fill();
      });

      const R = 68 + Math.sin(t * 0.05) * 10;
      const g = ctx.createRadialGradient(W / 2, H / 2, R * 0.3, W / 2, H / 2, R);
      g.addColorStop(0,    "rgba(59,130,246,0)");
      g.addColorStop(0.7,  "rgba(59,130,246,0.12)");
      g.addColorStop(1,    "rgba(96,165,250,0.45)");
      ctx.beginPath();
      ctx.arc(W / 2, H / 2, R, 0, Math.PI * 2);
      ctx.strokeStyle = g;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      t++;
      animRef.current = requestAnimationFrame(draw);
    };
    draw();

    const onResize = () => {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    };
    window.addEventListener("resize", onResize);
    return () => {
      cancelAnimationFrame(animRef.current);
      window.removeEventListener("resize", onResize);
    };
  }, []);

  /* progress */
  useEffect(() => {
    const iv = setInterval(() => {
      setPct((p) => {
        const next = p + Math.random() * 3.5 + 1;
        if (next >= 100) {
          clearInterval(iv);
          setExiting(true);
          setTimeout(onDone, 900);
          return 100;
        }
        return next;
      });
    }, 55);
    return () => clearInterval(iv);
  }, [onDone]);

  const displayPct = Math.floor(Math.min(pct, 100));

  return (
    <div className={`ls${exiting ? " ls--out" : ""}`}>
      <canvas ref={canvasRef} className="ls__canvas" />
      <div className="ls__ui">
        <div className="ls__fork-ring">
          <ForkSVG />
        </div>
        <p className="ls__brand">SABOR <span>&amp;</span> ARTE</p>
        <p className="ls__sub">Gastronomia de Excelência</p>
        <div className="ls__bar-track">
          <div className="ls__bar-fill" style={{ width: `${displayPct}%` }} />
          <div className="ls__bar-glow" style={{ left: `${displayPct}%` }} />
        </div>
        <p className="ls__pct">{displayPct}%</p>
      </div>
    </div>
  );
}

/* ═══════════════════════════════
   PARTICLE INTRO
═══════════════════════════════ */
function ParticleIntro({ onEnter }) {
  const canvasRef   = useRef(null);
  const stateRef    = useRef({ scroll: 0, mx: -999, my: -999, entered: false });
  const frameRef    = useRef(null);
  const containerRef = useRef(null);

  /* scroll → zoom */
  useEffect(() => {
    const el = containerRef.current;
    if (!el) return;
    const onScroll = () => {
      stateRef.current.scroll = el.scrollTop;
      const pct = el.scrollTop / (window.innerHeight * 1.5);
      if (pct >= 1 && !stateRef.current.entered) {
        stateRef.current.entered = true;
        onEnter();
      }
    };
    el.addEventListener("scroll", onScroll, { passive: true });
    return () => el.removeEventListener("scroll", onScroll);
  }, [onEnter]);

  /* mouse distortion */
  useEffect(() => {
    const onMove  = (e) => { stateRef.current.mx = e.clientX; stateRef.current.my = e.clientY; };
    const onLeave = () => { stateRef.current.mx = -999; stateRef.current.my = -999; };
    window.addEventListener("mousemove", onMove);
    window.addEventListener("mouseleave", onLeave);
    return () => {
      window.removeEventListener("mousemove", onMove);
      window.removeEventListener("mouseleave", onLeave);
    };
  }, []);

  /* canvas */
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");

    let W, H;
    const resize = () => {
      W = canvas.width  = window.innerWidth;
      H = canvas.height = window.innerHeight;
    };
    resize();
    window.addEventListener("resize", resize);

    const N = 1800;
    const particles = [];
    for (let i = 0; i < N; i++) {
      const phi   = Math.acos(1 - (2 * (i + 0.5)) / N);
      const theta = Math.PI * (1 + Math.sqrt(5)) * i;
      const r     = 0.85 + Math.random() * 0.3;
      particles.push({
        bx:     Math.sin(phi) * Math.cos(theta) * r,
        by:     Math.cos(phi) * r,
        bz:     Math.sin(phi) * Math.sin(theta) * r,
        ox:     0,
        oy:     0,
        size:   1.2 + Math.random() * 2.2,
        speed:  0.0003 + Math.random() * 0.0006,
        offset: Math.random() * Math.PI * 2,
      });
    }

    let t = 0;
    const draw = () => {
      ctx.clearRect(0, 0, W, H);

      const bgG = ctx.createRadialGradient(W / 2, H / 2, 0, W / 2, H / 2, Math.max(W, H) * 0.7);
      bgG.addColorStop(0, "#060d1e");
      bgG.addColorStop(0.5, "#03070f");
      bgG.addColorStop(1, "#020509");
      ctx.fillStyle = bgG;
      ctx.fillRect(0, 0, W, H);

      const { scroll, mx, my } = stateRef.current;
      const scrollPct  = Math.min(scroll / (window.innerHeight * 1.5), 1);
      const scale      = 180 + scrollPct * (Math.max(W, H) * 1.4 - 180);
      const cx = W / 2, cy = H / 2;
      const mdist      = Math.hypot(mx - cx, my - cy);
      const mInfluence = Math.max(0, 1 - mdist / 320);

      particles.forEach((p) => {
        const angle = t * p.speed + p.offset;
        const cosA = Math.cos(angle), sinA = Math.sin(angle);
        const rx = p.bx * cosA - p.bz * sinA;
        const rz = p.bx * sinA + p.bz * cosA;
        const ry = p.by;

        const z  = rz * 0.3 + 1.3;
        const px = cx + (rx * scale) / z;
        const py = cy + (ry * scale) / z;

        const dfm      = Math.hypot(px - mx, py - my);
        const dStr     = Math.max(0, 1 - dfm / 180) * 55 * mInfluence;
        const ang2     = Math.atan2(py - my, px - mx);
        p.ox += (Math.cos(ang2) * dStr - p.ox) * 0.12;
        p.oy += (Math.sin(ang2) * dStr - p.oy) * 0.12;

        const depthAlpha = (rz + 1) / 2;
        const alpha = (0.35 + depthAlpha * 0.65) * (1 - scrollPct * 0.5);
        const hue   = 200 + depthAlpha * 20;
        const sat   = 80 + depthAlpha * 20;
        const lgt   = 50 + depthAlpha * 40;

        ctx.beginPath();
        ctx.arc(px + p.ox, py + p.oy, (p.size * (0.6 + depthAlpha * 0.8)) / z, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${hue},${sat}%,${lgt}%,${alpha})`;
        ctx.fill();
      });

      const innerG = ctx.createRadialGradient(cx, cy, 0, cx, cy, scale * 0.45);
      innerG.addColorStop(0, `rgba(96,165,250,${0.07 + scrollPct * 0.1})`);
      innerG.addColorStop(0.6, "rgba(59,130,246,0.03)");
      innerG.addColorStop(1, "transparent");
      ctx.fillStyle = innerG;
      ctx.fillRect(0, 0, W, H);

      ctx.beginPath();
      ctx.arc(cx, cy, scale * 0.96, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(96,165,250,${0.16 + Math.sin(t * 0.02) * 0.07})`;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      t++;
      frameRef.current = requestAnimationFrame(draw);
    };
    draw();

    return () => {
      cancelAnimationFrame(frameRef.current);
      window.removeEventListener("resize", resize);
    };
  }, []);

  return (
    <div className="intro-scroll-container" ref={containerRef}>
      <div className="intro-wrap">
        <canvas ref={canvasRef} className="intro-canvas" />
        <div className="intro-teams">
          {["SEGUNDA", "TERÇA", "QUARTA", "QUINTA", "SEXTA", "SÁBADO", "DOMINGO"].map((d) => (
            <span key={d} className="intro-team">{d}</span>
          ))}
        </div>
        <div className="intro-bottom">
          <p className="intro-restaurant">
            SABOR <span className="intro-amp">&amp;</span> ARTE
          </p>
          <p className="intro-hint">Role para entrar →</p>
        </div>
      </div>
    </div>
  );
}

/* ═══════════════════════════════
   MEAL CARD
═══════════════════════════════ */
function MealCard({ item, index, onSelect }) {
  const [hov, setHov]   = useState(false);
  const [tilt, setTilt] = useState({ x: 0, y: 0 });
  const cardRef = useRef(null);
  const [g1, g2, g3]    = GRADIENTS[index % GRADIENTS.length];

  const onMouseMove = (e) => {
    const rect = cardRef.current.getBoundingClientRect();
    const cx   = rect.left + rect.width  / 2;
    const cy   = rect.top  + rect.height / 2;
    setTilt({
      x: ((e.clientY - cy) / (rect.height / 2)) * -10,
      y: ((e.clientX - cx) / (rect.width  / 2)) *  10,
    });
  };

  const onMouseLeave = () => {
    setHov(false);
    setTilt({ x: 0, y: 0 });
  };

  const tiltStyle = hov
    ? `perspective(900px) rotateX(${tilt.x}deg) rotateY(${tilt.y}deg) translateY(-10px) scale(1.02)`
    : "perspective(900px) rotateX(0) rotateY(0) scale(1)";

  return (
    <div
      ref={cardRef}
      className={`mc${hov ? " mc--on" : ""}`}
      style={{
        "--g1":    g1,
        "--g2":    g2,
        "--g3":    g3,
        "--c":     DAY_COLORS[item.dayWeek] || "#3b82f6",
        "--delay": `${index * 0.07}s`,
        transform: tiltStyle,
        transition: "transform .25s cubic-bezier(.4,0,.2,1), box-shadow .3s",
      }}
      onMouseEnter={() => setHov(true)}
      onMouseMove={onMouseMove}
      onMouseLeave={onMouseLeave}
    >
      <div className="mc__border-glow" />

      <div className="mc__img-shell">
        <img src={item.image} alt={item.name} className="mc__img" loading="lazy" />
        <div className="mc__img-mask" />
        <div className="mc__img-color-overlay" />
        <span className="mc__badge">{item.tag}</span>
        <span className="mc__day">{item.dayWeek}</span>
      </div>

      <div className="mc__strip" />

      <div className="mc__body">
        <span className="mc__num">0{index + 1}</span>
        <h3 className="mc__name">{item.name}</h3>
        <p className="mc__desc">{item.description}</p>

        <div className="mc__meta">
          <div className="mc__meta-item">
            <span className="mc__meta-lbl">CALORIAS</span>
            <span className="mc__meta-val">{item.calories} kcal</span>
          </div>
          <div className="mc__meta-divider" />
          <div className="mc__meta-item mc__meta-item--price">
            <span className="mc__meta-lbl">PREÇO</span>
            <span className="mc__price">{item.price}</span>
          </div>
        </div>

        <button className="mc__btn" onClick={() => onSelect(item)}>
          <span className="mc__btn-text">AVALIAR</span>
          <span className="mc__btn-icon">→</span>
          <span className="mc__btn-ripple" />
        </button>
      </div>
    </div>
  );
}

/* ═══════════════════════════════
   MODAL
═══════════════════════════════ */
function Modal({ item, onClose }) {
  const [g1, g2] = GRADIENTS[item.id % GRADIENTS.length];
  const dayColor  = DAY_COLORS[item.dayWeek] || "#3b82f6";

  useEffect(() => {
    document.body.style.overflow = "hidden";
    return () => { document.body.style.overflow = ""; };
  }, []);

  return (
    <div className="modal-bg" onClick={onClose}>
      <div className="modal" onClick={(e) => e.stopPropagation()}>
        <div
          className="modal__header"
          style={{ "--mg1": g1, "--mg2": g2 }}
        >
          <img src={item.image} alt={item.name} className="modal__img" />
          <div className="modal__header-fade" />
          <button className="modal__close" onClick={onClose}>✕</button>
          <div className="modal__header-title">
            <span className="modal__day" style={{ "--c": dayColor }}>{item.dayWeek}</span>
            <h2 className="modal__name">{item.name}</h2>
          </div>
        </div>

        <div className="modal__body">
          <p className="modal__desc">{item.description}</p>

          <div className="modal__stats">
            {[
              ["CALORIAS",  `${item.calories} kcal`],
              ["CATEGORIA", item.tag],
            ].map(([label, value]) => (
              <div
                key={label}
                className="modal__stat"
                style={{ "--sg1": g1, "--sg2": g2 }}
              >
                <span className="modal__stat-l">{label}</span>
                <span className="modal__stat-v">{value}</span>
              </div>
            ))}
          </div>

          <button
            className="modal__cta"
            style={{ "--mg1": g1, "--mg2": g2 }}
          >
            <span>FAZER PEDIDO</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  );
}

/* ═══════════════════════════════
   CURSOR GLOW
═══════════════════════════════ */
function CursorGlow() {
  const ref = useRef(null);
  useEffect(() => {
    const move = (e) => {
      if (ref.current) {
        ref.current.style.left = `${e.clientX}px`;
        ref.current.style.top  = `${e.clientY}px`;
      }
    };
    window.addEventListener("mousemove", move);
    return () => window.removeEventListener("mousemove", move);
  }, []);
  return <div className="cursor" ref={ref} />;
}

/* ═══════════════════════════════
   SPOTLIGHT
═══════════════════════════════ */
function SpotlightLayer() {
  const ref = useRef(null);
  useEffect(() => {
    const move = (e) => {
      if (ref.current)
        ref.current.style.background = `radial-gradient(700px at ${e.clientX}px ${e.clientY}px, rgba(59,130,246,.06) 0%, transparent 65%)`;
    };
    window.addEventListener("mousemove", move);
    return () => window.removeEventListener("mousemove", move);
  }, []);
  return <div className="spotlight" ref={ref} />;
}

/* ═══════════════════════════════
   PARTICLES BG
═══════════════════════════════ */
function ParticlesBg() {
  return (
    <div className="pbg" aria-hidden="true">
      {Array.from({ length: 22 }, (_, i) => (
        <div
          key={i}
          className="pbg__dot"
          style={{
            left:              `${(i * 4.54) % 100}%`,
            animationDelay:    `${(i * 0.38) % 6}s`,
            animationDuration: `${4 + (i % 5)}s`,
            width:             i % 3 === 0 ? "3px" : "2px",
            height:            i % 3 === 0 ? "3px" : "2px",
          }}
        />
      ))}
    </div>
  );
}

/* ═══════════════════════════════
   MAIN
═══════════════════════════════ */
export default function Refeicoes() {
  const [phase, setPhase]       = useState("loading"); // loading | intro | main
  const [refeicoes, setRefeicoes] = useState([]);
  const [selected, setSelected]   = useState(null);
  const [filter, setFilter]       = useState("Todos");
  const [navSolid, setNavSolid]   = useState(false);

  const filtered = filter === "Todos"
    ? refeicoes
    : refeicoes.filter((r) => r.dayWeek === filter);

  useEffect(() => {
    api.get("/refeicao").then((r) => setRefeicoes(r.data));
  }, []);

  useEffect(() => {
    const h = () => setNavSolid(window.scrollY > 60);
    window.addEventListener("scroll", h, { passive: true });
    return () => window.removeEventListener("scroll", h);
  }, []);

  const handleLoadDone = useCallback(() => setPhase("intro"), []);
  const handleEnter    = useCallback(() => {
    setPhase("main");
    setTimeout(() => window.scrollTo({ top: 0, behavior: "instant" }), 50);
  }, []);

  return (
    <>
      {phase === "loading" && <LoadingScreen onDone={handleLoadDone} />}

      {phase === "intro" && <ParticleIntro onEnter={handleEnter} />}

      {phase === "main" && (
        <div className="app app--in">
          <CursorGlow />
          <SpotlightLayer />

          {/* NAV */}
          <nav className={`nav${navSolid ? " nav--solid" : ""}`}>
            <div className="nav__brand">
              <div className="nav__fork"><ForkSVG /></div>
              <span className="nav__title">SABOR &amp; ARTE</span>
            </div>
            <ul className="nav__links">
              {["INÍCIO", "CARDÁPIO", "CHEF", "RESERVAS"].map((n) => (
                <li key={n} className="nav__link">{n}</li>
              ))}
            </ul>
          </nav>

          {/* HERO */}
          <section className="hero">
            <div className="hero__noise" />
            <ParticlesBg />

            <div className="hero__left">
              <p className="hero__eyebrow">— EXPERIÊNCIA GASTRONÔMICA —</p>
              <h1 className="hero__h1">
                <span className="hero__l1">CARDÁPIO</span>
                <span className="hero__l2">DA SEMANA</span>
              </h1>
              <p className="hero__sub">
                Uma jornada culinária cuidadosamente elaborada pela nutricionista,
                com ingredientes frescos selecionados diariamente.
              </p>
              <div className="hero__btns">
                <a href="#cardapio" className="btn-p">
                  <span>VER CARDÁPIO</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                    <path d="M12 5v14M5 12l7 7 7-7" />
                  </svg>
                  <span className="btn-p__g" />
                </a>
                <button className="btn-ghost">JORNAL</button>
              </div>
              <div className="hero__stats">
                {[["60+", "ANOS"], ["4.9★", "AVALIAÇÃO"], ["200+", "PRATOS"]].map(([v, l]) => (
                  <div key={l} className="hero__stat">
                    <span className="hero__sv">{v}</span>
                    <span className="hero__sl">{l}</span>
                  </div>
                ))}
              </div>
            </div>

            <div className="hero__right">
              <div className="hero__halo" />
              <ForkSVG />
              <div className="hero__shadow" />
            </div>
          </section>

          {/* DIVIDER */}
          <div className="div-line">
            <div />
            <span>✦</span>
            <div />
          </div>

          {/* CARDÁPIO */}
          <section className="cardapio" id="cardapio">
            <div className="cardapio__head">
              <span className="cardapio__over">MENU SEMANAL</span>
              <h2 className="cardapio__title">Pratos da Semana</h2>
              <p className="cardapio__sub">
                Cada prato é uma obra de arte. Preparado com paixão, servido com excelência.
              </p>
            </div>

            <div className="filters">
              {DAYS.map((d) => (
                <button
                  key={d}
                  className={`fp${filter === d ? " fp--on" : ""}`}
                  style={
                    filter === d && DAY_COLORS[d]
                      ? { "--fc": DAY_COLORS[d] }
                      : {}
                  }
                  onClick={() => setFilter(d)}
                >
                  {d}
                </button>
              ))}
            </div>

            <div className="meals-grid">
              {filtered.map((r, i) => (
                <MealCard
                  key={r.id}
                  item={r}
                  index={i}
                  onSelect={setSelected}
                />
              ))}
            </div>
          </section>

          <footer className="footer">
            <div className="footer__fork"><ForkSVG /></div>
            <p className="footer__brand">◈ SABOR &amp; ARTE</p>
            <p className="footer__tag">
              Gastronomia que transforma momentos em memórias.
            </p>
            <div className="footer__rule" />
            <p className="footer__copy">
              © 2025 Sabor &amp; Arte. Todos os direitos reservados.
            </p>
          </footer>

          {selected && (
            <Modal item={selected} onClose={() => setSelected(null)} />
          )}
        </div>
      )}
    </>
  );
}